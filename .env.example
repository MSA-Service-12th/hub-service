# hub-service 로컬 환경 변수 템플릿
# 사용법: 본 파일을 .env로 복사한 뒤 실제 값으로 채워넣는다 (cp .env.example .env)
# .env 파일은 .gitignore에 등록되어 커밋되지 않는다.

# ─── DB ─────────────────────────────────────────
DB_URL=localhost:5435/hub
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ─── Eureka ──────────────────────────────────────
EUREKA_SERVER_URL=http://localhost:18761/eureka

# ─── Kafka (GCP, SSL) ────────────────────────────
# 브로커 주소는 팀 GCP Kafka 클러스터. 외부 노출 금지.
BOOTSTRAP_SERVERS=
TRUST_STORE_PASSWORD=

# ─── Topics (선택, application.yaml 기본값 사용 가능) ──
# TOPICS_ORDER_PENDING=prod-order-pending
# TOPICS_HUB_UPDATED=hub-update-topic
# TOPICS_HUB_STOCK_UPDATED=prod-hub-stock-updated
